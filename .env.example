# Canonical URL used for OAuth callbacks. Use HTTPS outside local development.
THEORY_PUBLIC_URL=http://127.0.0.1:5173

# Register a Web application with each provider and copy its credentials here.
# Leave a pair empty to keep that provider disabled.
THEORY_GOOGLE_CLIENT_ID=
THEORY_GOOGLE_CLIENT_SECRET=
THEORY_MICROSOFT_CLIENT_ID=
THEORY_MICROSOFT_CLIENT_SECRET=
THEORY_MICROSOFT_TENANT=common
THEORY_LINKEDIN_CLIENT_ID=
THEORY_LINKEDIN_CLIENT_SECRET=

# Optional external MFA-backed staff login. No customer account is automatically staff.
# Standard owner email/password access uses an explicit database grant instead;
# see docs/owner-console.md and scripts/owner-access.mjs. These variables are optional.
# Register callback: THEORY_OWNER_URL/api/owner/auth/callback
# The provider must enforce MFA and emit verified amr:["mfa"] + auth_time.
THEORY_OWNER_URL=http://127.0.0.1:5173
THEORY_OWNER_ISSUER=
THEORY_OWNER_CLIENT_ID=
THEORY_OWNER_CLIENT_SECRET=
# JSON array of exact OIDC subjects, display names and platform roles. Keep private.
THEORY_OWNER_STAFF=[]

# Optional private calendar imports (separate consent from social sign-in).
# Register these Web OAuth callback URLs on the existing provider app, or use
# dedicated calendar credentials below (blank falls back to the sign-in pair):
# THEORY_PUBLIC_URL/api/calendar/oauth/microsoft/callback
# THEORY_PUBLIC_URL/api/calendar/oauth/google/callback
THEORY_CALENDAR_MICROSOFT_CLIENT_ID=
THEORY_CALENDAR_MICROSOFT_CLIENT_SECRET=
THEORY_CALENDAR_GOOGLE_CLIENT_ID=
THEORY_CALENDAR_GOOGLE_CLIENT_SECRET=
# Required for HTTPS deployments: base64-encoded random 32-byte encryption key.
# Keep it private and backed up; do not commit it or replace it casually.
# Local development creates .data/calendar-master.key when first connecting.
THEORY_CALENDAR_MASTER_KEY=
